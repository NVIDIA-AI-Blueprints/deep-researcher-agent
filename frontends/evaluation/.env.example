# Copy this file to .env and fill in the blank credential values.

# AI-Q runtime logging.
NVIDIA_NAT_LOG_LEVEL=WARNING

# NVIDIA-hosted model credentials.
NVIDIA_API_KEY=

# AI-Q search tool credentials.
TAVILY_API_BASE_URL=https://api.tavily.com
TAVILY_API_KEY=
SERPER_API_KEY=

# Gemini grader endpoint. Leave empty to use Google's official Gemini API.
GEMINI_API_URL=
GEMINI_API_KEY=

# DeepSearchQA grader settings.
DSQA_GRADER_MODEL=gemini-2.5-flash
DSQA_GRADER_MAX_RETRIES=5

# DeepResearch Bench II grader settings.
DRB2_GRADER_MODEL=gemini-2.5-pro
DRB2_GRADER_CHUNK_SIZE=50
DRB2_GRADER_MAX_RETRIES=10
DRB2_GRADER_MAX_PAPER_CHARS=150000
